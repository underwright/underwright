{
  "name": "underwright",
  "version": "0.1.0",
  "description": "Control plane for agentic software development: shared task registry, agent coordination, and evidence-backed completion.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "underwright": "./dist/cli.js",
    "uw-runner": "./dist/uw-runner.js"
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js serve",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:contract": "node scripts/test-contract.mjs",
    "depcruise": "depcruise --config .dependency-cruiser.cjs src"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.3.0",
    "postgres": "^4.0.0",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.25.10",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.7.0",
    "dependency-cruiser": "^18.7.2",
    "typescript": "^5.6.0",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
