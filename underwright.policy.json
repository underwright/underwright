{
  "dod": {
    "feature": {
      "evidence": [
        "test_run",
        "coverage",
        "review"
      ],
      "tdd": true,
      "min_coverage": 80
    },
    "bug": {
      "evidence": [
        "test_run",
        "review"
      ],
      "tdd": true
    },
    "deploy": {
      "evidence": [
        "deploy",
        "smoke_test"
      ]
    },
    "architecture": {
      "artifacts": [
        "design"
      ],
      "evidence": [
        "review"
      ]
    },
    "docs": {
      "evidence": [
        "review"
      ]
    },
    "tdd": {
      "evidence": [
        "test_run"
      ],
      "tdd": true
    },
    "review": {
      "artifacts": [
        "review"
      ]
    },
    "default": {
      "evidence": [
        "test_run"
      ]
    }
  },
  "enforcement": "warn",
  "lifecycle": {
    "enabled": true,
    "design_estimates": [
      "L"
    ],
    "pipelines": {}
  },
  "sdlc": {
    "retro": {
      "enabled": true,
      "every_days": 7
    },
    "grooming": {
      "enabled": true,
      "every_minutes": 60,
      "stale_open_days": 14,
      "stale_claim_minutes": 120,
      "reset_estimates": false
    }
  },
  "watch": {
    "max_inflight": 14,
    "max_agent_jobs_per_day": 80,
    "codex_seats": [
      "/home/alan/.codex-seat-gmail",
      "/home/alan/.codex-seat-covasant"
    ],
    "unblock": {
      "enabled": true,
      "stale_hours": 24,
      "reblock_hours": 12,
      "escalate_to": "human",
      "rules": [
        {
          "dep_satisfied": true,
          "action": "reopen",
          "note": "all dependency blockers done"
        },
        {
          "match": "database is locked",
          "action": "reopen",
          "note": "transient sqlite contention"
        },
        {
          "match": "SQLITE_BUSY",
          "action": "reopen",
          "note": "transient sqlite contention"
        },
        {
          "match": "claim_task refused",
          "action": "escalate",
          "note": "dependency still unmet"
        },
        {
          "match_regex": "5.?hour|quota|rate.?limit|429",
          "action": "escalate",
          "note": "quota \u2014 needs seat failover or human"
        }
      ]
    }
  },
  "dor": {
    "require_type": true,
    "require_ac_ids": true,
    "require_estimate": true,
    "require_description": false
  },
  "dispatcher": {
    "enabled": true,
    "max_tasks_per_agent": 3,
    "idle_minutes": 15,
    "review": {
      "require_different_harness": true,
      "prefer_stronger": true
    },
    "node_retry": {
      "kinds": [
        "run-script"
      ],
      "max_attempts": 2
    }
  },
  "harness_matrix": {
    "agents": {
      "codex@laptop-2": {
        "harness": "codex",
        "backend": "omnigent"
      },
      "claude@minipc": {
        "harness": "claude-sdk",
        "backend": "omnigent"
      },
      "grok@alandesktop": {
        "harness": "grok"
      },
      "agy@alandesktop": {
        "harness": "agy"
      },
      "kimi@alandesktop": {
        "harness": "kimi"
      },
      "cmdc@winbox": {
        "harness": "cmdc"
      }
    },
    "coverage": {
      "codex": true,
      "claude-sdk": true,
      "cmdc": false,
      "kimi": true,
      "agy": true,
      "opencode": true,
      "pi": true,
      "grok": true,
      "cursor": true
    }
  },
  "github_status": {
    "status_comments": true,
    "digest_hours": 24,
    "repo": "underwright/underwright"
  },
  "model_routing": {
    "enabled": true,
    "default_tier": "standard",
    "rules": [
      {
        "type": [
          "architecture",
          "design"
        ],
        "tier": "heavy"
      },
      {
        "review_kind": [
          "design"
        ],
        "tier": "heavy"
      },
      {
        "estimate": [
          "L"
        ],
        "tier": "heavy"
      },
      {
        "min_ac": 6,
        "tier": "heavy"
      },
      {
        "paths": [
          "src/schema.ts",
          "src/store.ts",
          "src/pstore.ts"
        ],
        "tier": "heavy"
      },
      {
        "estimate": [
          "S"
        ],
        "tier": "light"
      },
      {
        "type": [
          "docs"
        ],
        "tier": "light"
      }
    ],
    "models": {
      "claude": {
        "light": "haiku",
        "standard": "sonnet",
        "heavy": "opus"
      },
      "codex": {
        "light": "gpt-5.4-mini",
        "standard": "gpt-5.4",
        "heavy": "gpt-5.4"
      },
      "grok": {
        "light": "grok-4.7-build-fast",
        "standard": "grok-4.7",
        "heavy": "grok-4.7"
      },
      "cursor": {
        "light": "gpt-5.4-nano",
        "standard": "composer-2.5",
        "heavy": "claude-opus-5"
      }
    },
    "flags": {
      "grok": "-m",
      "cursor": "--model"
    }
  },
  "dispatch": {
    "enabled": true,
    "default_workspace": "underwright",
    "workspaces": {
      "underwright/underwright": "underwright",
      "alandennis1024/kraftina": "kraftina",
      "covasant/Aura": "auraa_0"
    },
    "harness_order": [
      "claude",
      "codex",
      "grok",
      "cursor",
      "opencode",
      "agy",
      "kimi",
      "devin",
      "command-code",
      "copilot",
      "pi"
    ],
    "free_fallback": [
      "devin",
      "cmdc",
      "command-code",
      "opencode"
    ]
  },
  "rubrics": {
    "covasant/Aura": {
      "enforcement": "block",
      "prompt": "AURA RUBRIC (covasant/Aura \u2014 enforced at review against .claude/commands/review-prs.md): Follow CLAUDE.md 'Working a bug: the standard protocol' and docs/dev/ISSUE_WORKFLOW.md. (1) Verify not already fixed: check pending-deploy/deployed labels and git log origin/develop --grep='#<issue>'. (2) Write the failing test first and mutation-verify it. (3) Measure regression against a real baseline; auraa_apis tests/ and resources/ run as separate invocations. (4) Run pre-commit lint on every touched file including pre-existing errors. (5) Ship a post-deploy validation script at scripts/validate/<issue>.py: self-contained, positive and negative cases, preflight() from scripts/validate/_lib.py, exit 0 PASS / 1 FAIL / 2 INCONCLUSIVE, --selftest or --offline mode. (6) The PR references the issue and leaves it OPEN \u2014 never close your own issue; add pending-deploy only when the fix merges. (7) Work only issues owned by or assigned to alanatcovasant. If you cannot meet the bar, post a blocked artifact and release \u2014 do not report done.",
      "dod": {
        "types": [
          "feature",
          "bug",
          "tdd"
        ],
        "evidence": [
          "test_run"
        ],
        "evidence_match": [
          {
            "kind": "test_run",
            "pattern": "scripts/validate/",
            "severity": "warn",
            "desc": "no run of scripts/validate/<issue>.py cited in evidence"
          }
        ]
      },
      "review": {
        "auto": true,
        "types": [
          "feature",
          "bug",
          "tdd"
        ],
        "checklist": "Apply the covasant/Aura review rubric (repo: .claude/commands/review-prs.md) to the implementer's branch/PR on the linked task. Criteria: (1) aligned with Auraa's vision \u2014 horizontal, domain-neutral, tool-first/governed; (2) no inappropriate hardcoded values \u2014 runtime config via DABs variables, not literals; (3) tests present AND passing \u2014 run them yourself and quote the output, UNVERIFIED counts as fail; (4) no serious issues \u2014 correctness, security, tenant isolation, breaking API, data-corruption patterns, error handlers that report what failed vs what they assumed; (5) post-deploy validation script at scripts/validate/<issue>.py \u2014 one command, preflight() requirements, positive+negative cases, exit 0/1/2, --selftest or --offline \u2014 or a documented reason it is infeasible. Post a review artifact giving each criterion PASS/FAIL/N/A with one-line evidence and an overall verdict, attach report_evidence kind=review citing ac1, then complete_task."
      }
    }
  }
}