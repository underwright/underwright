{
  "dod": {
    "feature":      { "evidence": ["test_run", "coverage", "review"], "tdd": true, "min_coverage": 80 },
    "bug":          { "evidence": ["test_run", "review"], "tdd": true },
    "deploy":       { "evidence": ["deploy", "smoke_test"] },
    "architecture": { "artifacts": ["design"], "evidence": ["review"] },
    "docs":         { "evidence": ["review"] },
    "tdd":          { "evidence": ["test_run"], "tdd": true },
    "default":      { "evidence": ["test_run"] }
  },
  "enforcement": "warn",
  "dor": {
    "require_type": true,
    "require_ac_ids": true,
    "require_estimate": true,
    "require_description": false
  },
  "dispatcher": {
    "enabled": true,
    "max_tasks_per_agent": 0,
    "idle_minutes": 15
  },
  "harness_matrix": {
    "agents": {
      "codex@laptop-2":   { "harness": "codex", "backend": "omnigent" },
      "claude@minipc":    { "harness": "claude-sdk", "backend": "omnigent" },
      "grok@alandesktop": { "harness": "grok" },
      "agy@alandesktop":  { "harness": "agy" },
      "kimi@alandesktop": { "harness": "kimi" },
      "cmdc@winbox":      { "harness": "cmdc" }
    },
    "coverage": {
      "codex": true,
      "claude-sdk": true,
      "cmdc": false
    }
  }
}
